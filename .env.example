# Copy this file to .env.local and fill in the values.

# Your Formspree form ID — the part after /f/ in https://formspree.io/f/xxxxxxxx
# Create a free form at https://formspree.io, then paste the ID here.
NEXT_PUBLIC_FORMSPREE_ID=

# The public URL of the site, used for SEO, Open Graph and the sitemap.
# Example: https://hassanahmad.vercel.app
NEXT_PUBLIC_SITE_URL=
